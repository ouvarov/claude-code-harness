{
  "permissions": {
    "ask": [
      "Bash(gh pr merge *)",
      "Bash(git push origin main*)",
      "Bash(git push origin master*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/harness/hooks/review-gate.mjs\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
